# my-agent 配置模板 —— 复制为 .env 并按需填写。
# Copy this file to .env and fill in your values.
#
# .env 已被 .gitignore 忽略，密钥不会进入 git。
# The .env file is gitignored; secrets never enter git.
# 已显式 export 的环境变量优先，不会被 .env 覆盖。
# Explicitly exported environment variables take precedence over .env.

# ── 供应商选择 / Provider selection ───────────────────────────────
# deepseek（默认） / bailian（阿里云百炼） / moonshot（Kimi） / custom（任意 OpenAI 兼容）
MY_AGENT_PROVIDER=deepseek

# ── DeepSeek（默认供应商 / default provider）───────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 百炼 / Bailian (Alibaba Cloud DashScope) ───────────────────────
# 切换方式：MY_AGENT_PROVIDER=bailian 并取消下行注释
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Moonshot / Kimi 平台 ──────────────────────────────────────────
# 切换方式：MY_AGENT_PROVIDER=moonshot 并取消下行注释
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 自定义 OpenAI 兼容供应商 / Custom OpenAI-compatible provider ──
# 切换方式：MY_AGENT_PROVIDER=custom 并取消下行注释
# MY_AGENT_BASE_URL=https://api.openai.com/v1
# MY_AGENT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 可选 / Optional ────────────────────────────────────────────────
# 会话默认模型（覆盖 agent.toml 的 [agent].default_model）
# MY_AGENT_MODEL=kimi-k3

# 禁用文件系统沙箱（不推荐，仅限受信任环境）
# MY_AGENT_SANDBOX=off
