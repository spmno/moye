# moye 配置模板 —— 复制为 .env 并按需填写。
# Copy this file to .env and fill in your values.
#
# .env 已被 .gitignore 忽略，密钥不会进入 git。
# The .env file is gitignored; secrets never enter git.
# 已显式 export 的环境变量优先，不会被 .env 覆盖。
# Explicitly exported environment variables take precedence over .env.

# ── 供应商选择 / Provider selection ───────────────────────────────
# deepseek（默认） / bailian（阿里云百炼） / moonshot（Kimi） / volcengine（火山引擎 Ark） / custom（任意 OpenAI 兼容）
AGENT_PROVIDER=deepseek

# ── DeepSeek（默认供应商 / default provider）───────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 百炼 / Bailian (Alibaba Cloud DashScope) ───────────────────────
# 切换方式：AGENT_PROVIDER=bailian 并取消下行注释
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Moonshot / Kimi 平台 ──────────────────────────────────────────
# 切换方式：AGENT_PROVIDER=moonshot 并取消下行注释
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 火山引擎 Ark / Volcengine Ark ────────────────────────────────
# 切换方式：AGENT_PROVIDER=volcengine 并取消下行注释
# ARK_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# 套餐（可选）：standard（按量付费，默认）/ coding（Coding Plan）/ agent（Agent Plan）
# 不同套餐使用不同 API Key 和 Base URL，详见 agent.toml.example 中的 [provider].plan 说明。
# AGENT_PLAN=agent

# ── 自定义 OpenAI 兼容供应商 / Custom OpenAI-compatible provider ──
# 切换方式：AGENT_PROVIDER=custom 并取消下行注释
# AGENT_BASE_URL=https://api.openai.com/v1
# AGENT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ── 可选 / Optional ────────────────────────────────────────────────
# 会话默认模型（覆盖 agent.toml 的 [agent].default_model）
# AGENT_MODEL=kimi-k3

# 联网搜索：优先使用 Tavily Search API（免费额度，返回全套结构化结果与 AI 综合回答）。
# 留空/不设置时 web_search 回退到 DuckDuckGo（仅标题+摘要，并抓取首条结果全文）。
# 注册地址：https://tavily.com
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# 禁用文件系统沙箱（不推荐，仅限受信任环境）
# AGENT_SANDBOX=off

# 沙箱信任模式：开启后所有沙箱外访问自动授权，不再弹窗确认。
# 也可在 agent.toml 的 [sandbox].authorized_dirs 中预授权特定目录（更细粒度）。
# Sandbox trust mode: when enabled, all out-of-sandbox access is auto-authorized
# without prompting. You can also pre-authorize specific directories in
# agent.toml's [sandbox].authorized_dirs (more granular).
# AGENT_TRUST_SANDBOX=on
