# Agent 运行时配置。
# 通过环境变量 AGENT_PROVIDER 选择供应商（deepseek / bailian / moonshot / volcengine）。
# API Key 从供应商对应的环境变量读取（DEEPSEEK / DASHSCOPE / MOONSHOT / ARK）。

[provider]
# 默认供应商（deepseek / bailian / moonshot / volcengine / custom）。
# 优先级：AGENT_PROVIDER 环境变量（或 .env）> 此处配置 > deepseek。
# 推荐：把配置写进项目根的 .env 文件（参考 .env.example），启动时自动加载。
# Priority: AGENT_PROVIDER env (or .env) > this config > deepseek.
provider = "custom"

# 可选：全局覆盖 OpenAI 兼容 base URL。
# 优先级：AGENT_BASE_URL 环境变量 > 此处配置 > 供应商默认。
# Optional: global OpenAI-compatible base URL override.
# Priority: AGENT_BASE_URL env > this config > provider default.
base_url = "https://ai-gateway.mxcdp.com"

# 可选：自定义 API key 环境变量名（默认按供应商自动选择）。
# Optional: custom API key env var name (defaults to the provider's standard name).
api_key_env = "AGENT_API_KEY"

# 可选：API 套餐（standard / coding / agent）。仅部分供应商支持套餐端点：
#   volcengine: standard(按量 /api/v3) | coding(/api/coding/v3) | agent(/api/plan/v3)
#   bailian:    standard(按量) | coding(coding.dashscope.aliyuncs.com/v1)
#   moonshot:   standard(api.moonshot.cn/v1) | coding(api.kimi.com/coding/v1)
#   zhipu:      standard(api/paas/v4) | coding(api/coding/paas/v4)
# 注意：套餐 API Key 与按量付费 Key 不互通，需在对应套餐控制台单独创建。
# 优先级：AGENT_PLAN 环境变量 > 此处配置 > standard。
# Optional: API plan (standard / coding / agent). Only some providers support plan endpoints.
# Plan API keys are NOT interchangeable with pay-as-you-go keys.
# Priority: AGENT_PLAN env > this config > standard.
# plan = "agent"

[agent]
# 默认模型：需与供应商匹配。
# DeepSeek:  deepseek-v4-pro / deepseek-v4-flash
# Bailian:   qwen3.8-max / qwen3.7-plus / qwen3.7-flash / qwen-plus
# Moonshot:  kimi-k3 / kimi-k2.7-code-highspeed
# Volcengine: doubao-seed-evolving / doubao-seed-2-1-pro-260628 / doubao-seed-2-1-turbo-260628
# OpenAI:    gpt-5.6-sol / gpt-5.6-terra / gpt-5.6-luna
# Claude:    claude-fable-5 / claude-opus-5 / claude-sonnet-5 / claude-haiku-4-5
# Gemini:    gemini-3.1-pro-preview / gemini-3.6-flash / gemini-3.5-flash-lite
# MiMo:      mimo-v2.5-pro / mimo-v2.5
# Zhipu:     glm-5.3-flash / glm-5.2 / glm-5
# 切换模型用 REPL 命令：model <slug>
default_model = "glm-latest"
# 自主循环上限：agent 最多执行的轮数。
max_turns = 30

[context]
# 输出 token 上限：0 = 跳过（用模型自身默认输出预算，推荐；推理模型始终跳过）；
# >0 = 显式上限，作为 max_tokens 发给非推理模型（勿超过目标模型输出天花板，否则 400）。
# Output token cap: 0 = skip (use model's own default output budget, recommended;
# reasoning models always skip); >0 = explicit cap sent as max_tokens to non-reasoning
# models (must not exceed the target model's output ceiling, or 400 returns).
max_output_tokens = 0
compaction_threshold = 0.5
keep_recent_turns = 2
max_bash_output_chars = 20000
max_read_lines = 500
microcompact_threshold = 20000
microcompact_protected_results = 3
# SSE 流式空闲超时（秒）：两个 SSE 事件之间的最大允许间隔。
# 超过此间隔无数据时视为连接断开，触发自动重试。
# 推理模型（glm / deepseek-v4 / doubao-seed 等）思考阶段可能长时间不产出事件，
# 120 秒过短会误判断连；300 秒（5 分钟）更安全。设为 0 可禁用（不推荐）。
# SSE stream idle timeout (seconds): max gap between SSE events before the
# connection is treated as dropped and auto-retry kicks in. Reasoning models
# may go silent for minutes during thinking; 300s (5 min) is safer than 120s.
# Set to 0 to disable (not recommended).
sse_idle_timeout_secs = 300

# 各角色选择自己的模型与提示词文件。可用 REPL 命令 model <slug> 全局覆盖。
# 按工具的 HITL（人在环）权限分级：
#   allow = 自动执行不询问；ask = 暂停请人类确认；deny = 拦截调用并说明原因。
#   read_file / run_bash_readonly 默认自动执行（如 ls, cat, git status）；
#   run_bash_mutating / edit_file 默认需询问。
[agents.orchestrator]
model = "glm-latest"
preamble = "AGENTS.md"
permissions.read_file = "allow"
permissions.run_bash_readonly = "allow"
permissions.run_bash_mutating = "deny"
permissions.edit_file = "deny"
permissions.write_file = "deny"
permissions.web_fetch = "allow"
permissions.web_search = "allow"

[agents.investigator]
model = "glm-latest"
preamble = "prompts/investigator.md"
max_turns = 20
permissions.read_file = "allow"
permissions.run_bash_readonly = "allow"
permissions.run_bash_mutating = "deny"
permissions.edit_file = "deny"
permissions.write_file = "deny"
permissions.web_fetch = "allow"
permissions.web_search = "allow"

[agents.planner]
model = "glm-latest"
preamble = "prompts/planner.md"
permissions.read_file = "allow"
permissions.run_bash_readonly = "allow"
permissions.run_bash_mutating = "deny"
permissions.edit_file = "deny"
permissions.write_file = "deny"
permissions.web_fetch = "allow"
permissions.web_search = "allow"

[agents.builder]
model = "glm-latest"
preamble = "prompts/builder.md"
permissions.read_file = "allow"
permissions.run_bash_readonly = "allow"
permissions.run_bash_mutating = "allow"
permissions.edit_file = "allow"
permissions.write_file = "allow"
permissions.web_fetch = "allow"
permissions.web_search = "allow"

[agents.auditor]
model = "glm-latest"
preamble = "prompts/auditor.md"
permissions.read_file = "allow"
permissions.run_bash_readonly = "allow"
permissions.run_bash_mutating = "deny"
permissions.edit_file = "deny"
permissions.write_file = "deny"
permissions.web_fetch = "deny"
permissions.web_search = "deny"

# ── 自定义子代理 / Custom sub-agents ──────────────────────────────────────
# 在 [agents.custom.<name>] 下声明自定义 agent，通过 task 工具的 agent 字段调用。
# 内置名 explore / build 优先于自定义同名。
# Declare custom agents under [agents.custom.<name>], called via the task
# tool's agent field. Built-in names explore / build take precedence over
# custom names with the same key.
#
# 字段 / Fields:
#   preamble     = preamble 文件路径（相对项目根）。文件不存在时用空 preamble。
#                  Preamble file path (relative to project root). Empty when missing.
#   model        = 可选模型覆盖；省略时用会话/注册表默认模型。
#                  Optional model override; omitted → session/registry default.
#   permissions  = 按工具的权限分级（与角色配置格式相同，省略的字段用默认值）。
#                  Per-tool permission tiers (same format as role configs;
#                  omitted fields use defaults).
#
# 子代理隔离：不获得 task / todo_write 工具，拥有独立的空对话历史。
# Sub-agent isolation: no task / todo_write tools, fresh empty history.
#
# [agents.custom.researcher]
# preamble = "agents/researcher.md"
# model = "glm-latest"
# permissions.read_file = "allow"
# permissions.run_bash_readonly = "allow"
# permissions.run_bash_mutating = "deny"
# permissions.edit_file = "deny"
# permissions.write_file = "deny"
# permissions.web_fetch = "allow"
# permissions.web_search = "allow"

[memory]
# JSONL 记忆存储（v1），可扩展为 sqlite。
dir = "memory"
conversation_file = "conversations.jsonl"
lessons_file = "lessons.jsonl"
rules_file = "rules.json"

[evolution]
# 自动学习式规则提升：被观察到 >= 阈值次数的规则会被提升到 AGENTS.md。
rule_escalation_threshold = 3

# ── 沙箱 / Sandbox ──────────────────────────────────────────────────────
# Agent 默认只能访问项目根目录（当前工作目录）及其子目录。
# 如果需要访问其它目录（如 /etc、/tmp、~/.config），会暂停并请求用户授权。
# 用户确认后，该目录被加入授权列表，后续访问不再询问。
#
# 通过环境变量 AGENT_SANDBOX=off 可禁用沙箱（不推荐）。
# 通过环境变量 AGENT_TRUST_SANDBOX=on 可在启动时开启信任模式（所有沙箱外访问自动授权）。
#
# The Agent can only access the project root (current working directory) and its
# subdirectories by default. Access to other directories (e.g. /etc, /tmp,
# ~/.config) will pause and prompt the user for authorization. Once authorized,
# the directory is added to the allow-list and subsequent accesses won't prompt.
#
# Disable via AGENT_SANDBOX=off (not recommended).
# Enable trust mode via AGENT_TRUST_SANDBOX=on (auto-authorize all out-of-sandbox access).

[sandbox]
# 预授权目录列表：这些目录及其子目录可直接访问，无需弹窗确认。
# 支持 ~ 展开（如 ~/.config）。
# 在沙箱外路径 HITL 提示中按 [a] "总是授权" 会自动将目录追加到此列表。
# Pre-authorized directory list: these directories and their subdirectories are
# accessible without prompting. Supports ~ expansion (e.g. ~/.config).
# Pressing [a] "always" in the sandbox out-of-path HITL prompt auto-appends
# the directory here.
#
# 示例 / Example:
# authorized_dirs = ["~/.config", "/tmp/moye", "../shared-libs"]
authorized_dirs = []

# 是否允许网络访问（仅 bwrap 后端生效，默认 true）。
# false 时 bwrap 命令行附加 --unshare-net，将子进程隔离到无网卡的命名空间。
# Landlock 后端无法控制网络命名空间——此选项在 landlock 模式下被忽略
# （启动时 tracing::warn 提醒）。
#
# Whether to allow network access (bwrap backend only, default true).
# When false, bwrap argv gets --unshare-net, isolating child processes in a
# net namespace with no interfaces. Landlock can't do network namespaces — this
# option is ignored in landlock mode (tracing::warn at startup).
# allow_network = true

# 命令规则：对 run_bash 的 command 字符串做 glob 匹配，首条匹配胜出（allow/ask/deny）。
# 在只读/会改变状态分类之前评估——让用户预授权高频可信命令（如 cargo test、git status）
# 或限制只读分类的命令。仅影响 run_bash，其他工具不受影响。
# 省略时为空，行为与现有只读/会改变状态分类完全一致（向后兼容）。
#
# Command rules: glob-matched against run_bash command strings, first match wins
# (allow/ask/deny). Evaluated BEFORE the readonly/mutating classification — lets
# users pre-approve trusted frequent commands (e.g. cargo test, git status) or
# restrict readonly-classified commands. Only affects run_bash; other tools unaffected.
# Absent → empty, fully backward compatible with existing classification.
#
# pattern 支持 * 通配符（匹配任意可为空序列）；其余字符按字面；大小写敏感。
# pattern supports * wildcards (matches any possibly-empty sequence);
# all other chars literal; case-sensitive.
#
# 示例 / Example:
# command_rules = [
#   { pattern = "cargo test*", tier = "allow" },
#   { pattern = "cargo build*", tier = "allow" },
#   { pattern = "git status*", tier = "allow" },
#   { pattern = "git log*", tier = "allow" },
#   { pattern = "npm run build*", tier = "allow" },
#   { pattern = "rm *", tier = "deny" },
# ]

# ── 验证门 / Verify Gate ─────────────────────────────────────────────────
# 在 Builder 产出后、Auditor 评审前自动运行构建/测试命令。
# 失败时将错误输出回传给 Builder 重试（最多 max_retries 次），耗尽则跳过审计。
# Auto-runs build/test commands after the Builder produces code and before the
# Auditor reviews. On failure, feeds the error output back to the Builder for a
# bounded retry loop (up to max_retries); when exhausted, the audit is skipped.
[verify]
# 是否启用验证门（默认 true）。
# Enable the verify gate (default true).
enabled = true
# 可选：手动覆盖验证命令列表。省略时按项目根的标记文件自动检测：
#   Cargo.toml → ["cargo build", "cargo test"]
#   package.json → ["npm test --if-present"]
#   pyproject.toml → ["pytest -q"]
#   go.mod → ["go test ./..."]
# Optional: override the verify command list. When omitted, auto-detected from
# the project root's marker files (see above).
# commands = ["cargo build", "cargo test"]
# 失败后的最大重试次数（默认 2）。
# Max retries after failure (default 2).
max_retries = 2
# 每条命令的超时秒数（默认 600）。
# Per-command timeout in seconds (default 600).
timeout_secs = 600

# ── 定时任务调度器 / Scheduler ───────────────────────────────────────────
# 通过 schedule_task 工具管理的定时任务，支持两种触发方式：
#   cron 周期任务：5 字段『分 时 日 月 周』或 6 字段『秒 分 时 日 月 周』
#   at 一次性任务：指定年月日时分秒（如 "2026-12-25 09:30:00"），执行一次后失效
# Scheduled tasks managed via the schedule_task tool; two trigger styles:
#   cron (recurring): 5-field "min hour day month weekday" or 6-field with a
#                     leading seconds field
#   at (one-shot): exact "YYYY-MM-DD HH:MM[:SS]", fires once then expires
[scheduler]
# 是否启用（默认 false）。
# Enable scheduled tasks (default false).
enabled = false
# 调度模式 / Scheduling mode:
#   "os"      —— 向操作系统调度器注册"每分钟心跳"，moye 进程退出后任务照常触发。
#                Linux/macOS 写入用户 crontab（标记块，多项目共存）；
#                Windows 注册任务计划（schtasks 每分钟运行包装 .cmd）。
#                注册失败时自动回退到 "process"。
#                手动管理：moye --scheduler-install / --scheduler-uninstall
#   "process" —— 进程内循环扫描（moye 退出后任务不再触发，历史行为）。
#   "os"      —— register a per-minute heartbeat with the OS scheduler; tasks
#                fire even when moye is not running. Linux/macOS: a marked block
#                in the user crontab (multi-project safe). Windows: a Task
#                Scheduler entry (schtasks) running a wrapper .cmd every minute
#                (note: runs only while the user is logged on by default).
#                Falls back to "process" if OS registration fails.
#                Manual control: moye --scheduler-install / --scheduler-uninstall
#   "process" —— in-process loop; tasks stop when moye exits (legacy behavior).
mode = "os"
# process 模式的扫描间隔秒数（默认 60；os 模式固定为系统调度的 1 分钟粒度）。
# Scan interval seconds for process mode (default 60; os mode is fixed at the
# OS scheduler's 1-minute granularity).
tick_secs = 60
# 同时执行的任务上限（默认 2）。
# Max concurrently executing tasks (default 2).
max_concurrent = 2
# 任务存储文件路径（默认 ~/.config/moye/scheduled_tasks.json）。
# Task store path (default ~/.config/moye/scheduled_tasks.json).
# store_path = "~/.config/moye/scheduled_tasks.json"
# 执行日志保留天数（默认 30）。
# Run-log retention days (default 30).
log_retention_days = 30
